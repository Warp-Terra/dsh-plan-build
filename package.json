{
  "name": "dsh-plan-build-mode",
  "version": "0.1.0",
  "description": "Always-visible Plan/Build mode chip and Tab switching for the DeepSeek Harness composer",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": ["dsh", "deepseek-harness", "plan-mode", "build-mode", "plugin"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-shortcuts"
      ]
    }
  }
}
